# Environment configuration
# Copy this file to .env and adjust values as needed.
#
# DEVELOPMENT: Uses VITE_* vars (loaded by Vite dev server)
# PRODUCTION:  Uses non-prefixed vars (injected at Docker container startup)

# =============================================================================
# DATABASE
# =============================================================================
DB_PASSWORD=developmentpassword
DB_USER=chatgamelab
DB_DATABASE=chatgamelab
PORT_POSTGRES=7003

# Database Backups (optional)
BACKUP_ENABLED=false
BACKUP_SSH_HOST=
BACKUP_SSH_PORT=22
BACKUP_SSH_USER=
BACKUP_SSH_KEY_PATH=/root/.ssh/backup_key
BACKUP_PATH=backups
# Hours before a successful backup is reported as stale on /api/status
BACKUP_MAX_AGE_HOURS=48

# =============================================================================
# BACKEND
# =============================================================================
PORT_BACKEND=7001
DEV_MODE=true
AUTH0_DOMAIN=your.auth0.domain
AUTH0_AUDIENCE=your.auth0.audience
DEV_JWT_SECRET=devsecret123
# Game sessions are deleted this many hours after their last activity (0 disables the purge).
# Only the session of the game a player is currently playing is reachable in the UI.
SESSION_RETENTION_HOURS=48
PUBLIC_URL=http://127.0.0.1:80

# =============================================================================
# USERS
# =============================================================================
# Comma-separated list of email addresses that will be auto-upgraded to admin role on sign-in
# Example: ADMIN_EMAILS=admin@example.com,superuser@example.com
ADMIN_EMAILS=

# Invite and re-login links are 3-4 words, so guessing is capped site-wide:
# more than TOKEN_LOCK_MAX_FAILURES unknown tokens within TOKEN_LOCK_WINDOW
# block every token check (correct ones too) for TOKEN_LOCK_DURATION.
# Defaults: 300, 10m, 5m.
TOKEN_LOCK_MAX_FAILURES=
TOKEN_LOCK_WINDOW=
TOKEN_LOCK_DURATION=

# =============================================================================
# FRONTEND - Development (Vite requires VITE_ prefix for local dev)
# =============================================================================
PORT_EXPOSED=80
VITE_API_BASE_URL=http://localhost:7001/api
VITE_AUTH0_DOMAIN=your.auth0.domain
VITE_AUTH0_CLIENT_ID=your_auth0_client_id
VITE_AUTH0_AUDIENCE=your.auth0.audience
# External homepage URL: When set, the root route (/) redirects here instead of
# showing the built-in landing page. Logout also redirects here.
# For local dev (Vite), use VITE_HOMEPAGE_URL. For production Docker, use HOMEPAGE_URL.
# VITE_HOMEPAGE_URL=https://your-landing-page.com

# Forward browser console.* output to the dev server terminal (default: true)
# Set to "false" to disable
# VITE_BROWSER_LOGS=false

# =============================================================================
# FRONTEND - Production Docker (runtime config, injected at container startup)
# In production, set these via your hosting provider or systemd Environment=
# Frontend also uses AUTH0_DOMAIN and AUTH0_AUDIENCE from the backend section above
# =============================================================================
# API_BASE_URL: Public URL where the API is accessible from the browser
# For self-sufficient Docker setup, this should be PUBLIC_URL + /api
# The frontend nginx will internally proxy /api/ requests to backend:3000
API_BASE_URL=http://yourdomain.com/api
AUTH0_CLIENT_ID=your_auth0_client_id
# HOMEPAGE_URL=https://your-landing-page.com

# =============================================================================
# TELEMETRY - Sentry / GlitchTip (optional)
# =============================================================================
# Error reporting via Sentry-compatible service (e.g. GlitchTip).
# Leave empty to disable. Backend and frontend use separate DSNs/projects.
SENTRY_DSN_BACKEND=
# Frontend has two vars because Vite only exposes VITE_* prefixed vars in dev.
# In production Docker, SENTRY_DSN_FRONTEND is injected at container startup.
# For local dev (npm run dev), set VITE_SENTRY_DSN_FRONTEND instead.
SENTRY_DSN_FRONTEND=
VITE_SENTRY_DSN_FRONTEND=
