# Managed by deploy/roles/nginx; certbot adds the TLS directives.
#
# The box's one public entry point. The app's backend serves the API, the
# engine's WebSocket and the embedded frontend on one port.

# Upgrade for WebSocket requests, keep-alive for the rest.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      '';
}

server {
    listen 80;
    listen [::]:80;
    server_name {{ inventory_hostname }};

{% if basic_auth_user | default('') | length > 0 %}
    # The instance's shared password (basic_auth_user, hash in
    # /etc/nginx/htpasswd-{{ inventory_hostname }}). Set per location, not on
    # the server, so certbot's challenge locations stay open.
    location = /api/health {
        proxy_pass http://127.0.0.1:{{ app_port }};
        proxy_set_header Host $host;
    }

{% endif %}
    location / {
{% if basic_auth_user | default('') | length > 0 %}
        auth_basic "{{ inventory_hostname }}";
        auth_basic_user_file /etc/nginx/htpasswd-{{ inventory_hostname }};
{% endif %}
        proxy_pass http://127.0.0.1:{{ app_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # The engine's WebSocket.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # Streamed stories reach the player as they are written.
        proxy_buffering off;

        # Image generation and long streams outlast nginx's 60s default.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    client_max_body_size 32m;
    server_tokens off;
}
